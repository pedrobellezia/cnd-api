    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst success = [];\nconst error = [];\n\nfor (const item of items) {\n   const json = item.json;\n\n   // ERROS\n   if (json.success === false) {\n     error.push(json);\n     continue;\n   }\n\n   // SUCESSOS\n   if (json.success === true && json.data) {\n     success.push({\n       file: json.file,\n       ...json.data\n     });\n   }\n}\n\n return [{\n   json: {\n     success,\n     error\n   }\n }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
