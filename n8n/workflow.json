    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH updated AS (\n    UPDATE cnd c\n    SET\n        \"createdAt\" = NOW()\n    FROM fornecedor f\n    JOIN cndtype ct\n      ON ct.name = $1\n    WHERE f.cnpj = $2\n      AND c.fornecedorid = f.id\n      AND c.cndtypeid = ct.id\n      AND c.status = 'error'\n    RETURNING c.* \n)\nINSERT INTO cnd (\n    \"id\",\n    \"fornecedorid\",\n    \"cndtypeid\",\n    \"status\"\n)\nSELECT\n    gen_random_uuid(),\n    f.id,\n    ct.id,\n    'error'\nFROM fornecedor f\nJOIN cndtype ct\n  ON ct.name = $1\nWHERE f.cnpj = $2\n  AND NOT EXISTS (\n      SELECT 1 FROM updated\n  );\n",
        "options": {
          "queryReplacement": "={{ [$json.details.cnd_type, $json.details.cnpj] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1264,
        448
