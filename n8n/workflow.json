{
  "name": "Cnd",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    f.*,\n    'fgts' AS \"cndtype\"\nFROM \"fornecedor\" f\nWHERE \n  (\n    $1 IS NOT NULL \n    AND f.cnpj = $1\n  )\n  OR (\n    $1 IS NULL\n    AND NOT EXISTS (\n      SELECT 1\n      FROM \"cnd\" c\n      JOIN \"cndtype\" ct ON c.\"cndtypeid\" = ct.id\n      WHERE c.\"fornecedorid\" = f.id\n        AND ct.name = 'fgts'\n        AND c.status = 'regular'\n        AND c.\"validade\" >= NOW() + INTERVAL $2\n    )\n    AND NOT EXISTS (\n      SELECT 1\n      FROM \"cnd\" c\n      JOIN \"cndtype\" ct ON c.\"cndtypeid\" = ct.id\n      WHERE c.\"fornecedorid\" = f.id\n        AND ct.name = 'fgts'\n        AND c.status IN ('error', 'irregular')\n        AND c.\"createdAt\" >= NOW() - INTERVAL $3\n    )\n  );",
        "options": {
          "queryReplacement": "={{ [$json.cnpj || null, '1 day', '1 day'] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        144,
        304
      ],
      "id": "f793eece-068f-446c-a5a0-65510654bc47",
      "name": "Buscar Fornecedor FGTS"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    f.*,\n    'trabalhista' AS \"cndtype\"\nFROM \"fornecedor\" f\nWHERE \n  (\n    $1 IS NOT NULL \n    AND f.cnpj = $1\n  )\n  OR (\n    $1 IS NULL\n    AND NOT EXISTS (\n      SELECT 1\n      FROM \"cnd\" c\n      JOIN \"cndtype\" ct ON c.\"cndtypeid\" = ct.id\n      WHERE c.\"fornecedorid\" = f.id\n        AND ct.name = 'trabalhista'\n        AND c.status = 'regular'\n        AND c.\"validade\" >= NOW() + INTERVAL $2\n    )\n    AND NOT EXISTS (\n      SELECT 1\n      FROM \"cnd\" c\n      JOIN \"cndtype\" ct ON c.\"cndtypeid\" = ct.id\n      WHERE c.\"fornecedorid\" = f.id\n        AND ct.name = 'trabalhista'\n        AND c.status IN ('error', 'irregular')\n        AND c.\"createdAt\" >= NOW() - INTERVAL $3\n    )\n  );",
        "options": {
          "queryReplacement": "={{ [$json.cnpj || null, '3 day', '1 day'] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        144,
        496
      ],
      "id": "9ff9001c-97eb-4e89-a7bd-dab24c8ab130",
      "name": "Buscar Fornecedor Trabalhista"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    f.*,\n    'estadual' AS \"cndtype\"\nFROM \"fornecedor\" f\nWHERE \n  ((\n    $1 IS NOT NULL \n    AND f.cnpj = $1\n  )\n  OR (\n    $1 IS NULL\n    AND NOT EXISTS (\n      SELECT 1\n      FROM \"cnd\" c\n      JOIN \"cndtype\" ct ON c.\"cndtypeid\" = ct.id\n      WHERE c.\"fornecedorid\" = f.id\n        AND ct.name = 'estadual'\n        AND c.status = 'regular'\n        AND c.\"validade\" >= NOW() + INTERVAL $2\n    )\n    AND NOT EXISTS (\n      SELECT 1\n      FROM \"cnd\" c\n      JOIN \"cndtype\" ct ON c.\"cndtypeid\" = ct.id\n      WHERE c.\"fornecedorid\" = f.id\n        AND ct.name = 'estadual'\n        AND c.status IN ('error', 'irregular')\n        AND c.\"createdAt\" >= NOW() - INTERVAL $3\n    )\n  )) AND EXISTS (\n    SELECT 1 \n    FROM \"estadual\" e\n    WHERE e.uf = f.uf\n  );",
        "options": {
          "queryReplacement": "={{ [$json.cnpj || null, '3 day', '2 day'] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        144,
        688
      ],
      "id": "f05969e5-54fb-4179-a3d2-b8b0bf6c0a30",
      "name": "Buscar Fornecedor Estadual"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    f.*,\n    'municipal' AS \"cndtype\"\nFROM \"fornecedor\" f\nWHERE \n  ((\n    $1 IS NOT NULL \n    AND f.cnpj = $1\n  )\n  OR (\n    $1 IS NULL\n    AND NOT EXISTS (\n      SELECT 1\n      FROM \"cnd\" c\n      JOIN \"cndtype\" ct ON c.\"cndtypeid\" = ct.id\n      WHERE c.\"fornecedorid\" = f.id\n        AND ct.name = 'municipal'\n        AND c.status = 'regular'\n        AND c.\"validade\" >= NOW() + INTERVAL $2\n    )\n    AND NOT EXISTS (\n      SELECT 1\n      FROM \"cnd\" c\n      JOIN \"cndtype\" ct ON c.\"cndtypeid\" = ct.id\n      WHERE c.\"fornecedorid\" = f.id\n        AND ct.name = 'municipal'\n        AND c.status IN ('error', 'irregular')\n        AND c.\"createdAt\" >= NOW() - INTERVAL $3\n    )\n  )) AND EXISTS (\n    SELECT 1 \n    FROM \"municipal\" m \n    WHERE m.municipio = f.municipio \n      AND m.uf = f.uf\n  );",
        "options": {
          "queryReplacement": "={{ [$json.cnpj || null, '3 day', '12 hours'] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
