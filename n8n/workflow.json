    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  if (item.binary?.data) {\n    return {\n      json: {\n        success: true\n      },\n      binary: item.binary\n    };\n  }\n\n  return {\n    json: {\n      success: false,\n      ...item.json\n    }\n  };\n});"
      },
